# Libérer de l’espace : worktrees fusionnés et dossiers de build, entrée Aujourd’hui, diskmap
app.reclaim.title = Libérer de l’espace
app.reclaim.menu = Libérer de l’espace…
app.reclaim.menu_size = Libérer {size}…
app.reclaim.total = {size} peuvent être libérés sans risque
app.reclaim.shared_total = {size} dans des dossiers cargo hors du dépôt (non proposés)
app.reclaim.worktree = {size} peuvent être libérés ici
app.reclaim.intro = Rien n’est sélectionné. Cochez ce que vous voulez mettre à la corbeille : chaque chemin, ce que c’est et ce que coûte sa suppression sont listés ci-dessous, et vous confirmez encore une fois avant que rien ne bouge.
app.reclaim.kind_merged = Worktrees fusionnés
app.reclaim.how_merged = Leur branche est sur la branche principale, sans rien de non validé ni de non poussé. Le dossier entier va à la corbeille, fichiers ignorés par git compris, et git oublie le worktree.
app.reclaim.kind_incremental = Caches de compilation incrémentale
app.reclaim.how_trash = Mis à la corbeille, jamais supprimés directement. L’espace revient quand vous videz la corbeille.
app.reclaim.kind_stale_target.one = Dossiers de build des worktrees inchangés depuis {n} jour
app.reclaim.kind_stale_target.other = Dossiers de build des worktrees inchangés depuis {n} jours
app.reclaim.kind_stale_deps.one = Dépendances et sorties de build des worktrees inchangés depuis {n} jour
app.reclaim.kind_stale_deps.other = Dépendances et sorties de build des worktrees inchangés depuis {n} jours
app.reclaim.cat_worktree = Worktree
app.reclaim.what_worktree = Le dossier va à la corbeille avec tout son contenu. La branche reste (sauf si vous cochez ci-dessous), donc git worktree add le recrée.
app.reclaim.cat_incremental = Cache incrémental (cargo)
app.reclaim.what_incremental = Le prochain build cargo le recrée ; ce build est plus lent.
app.reclaim.cat_target = Dossier de build (target cargo / Maven)
app.reclaim.what_target = Le prochain build recompile tout depuis zéro.
app.reclaim.cat_node_modules = Paquets installés (node_modules)
app.reclaim.what_node_modules = Lancez npm install (ou pnpm, yarn, bun install) pour les récupérer.
app.reclaim.cat_next = Build et cache Next.js (.next)
app.reclaim.what_next = Next.js le recrée au prochain dev ou build.
app.reclaim.cat_build = Sortie de build (dist / build)
app.reclaim.what_build = Votre build la recrée (npm run build, gradle build…). Pris seulement si git ignore tout son contenu.
app.reclaim.cat_gradle = Cache de projet Gradle (.gradle)
app.reclaim.what_gradle = Gradle le recrée au prochain build.
app.reclaim.cat_derived = DerivedData de Xcode
app.reclaim.what_derived = Xcode le reconstruit et réindexe le projet.
app.reclaim.keepers_loading = Recherche des fichiers que git ne suit pas ici…
app.reclaim.keepers_unknown = git n’a pas pu lister les fichiers qu’il ne suit pas ici ; ce worktree ne sera pas touché.
app.reclaim.keepers_none = Aucun fichier hors de git à part des sorties de build.
app.reclaim.keepers.one = {n} fichier que git ne suit pas va à la corbeille avec le dossier (vous pourrez l’y récupérer) :
app.reclaim.keepers.other = {n} fichiers que git ne suit pas vont à la corbeille avec le dossier (vous pourrez les y récupérer) :
app.reclaim.shared_title = Dossiers cargo hors du dépôt
app.reclaim.shared_how = Non proposés : d’autres dépôts, et des builds en cours, peuvent les utiliser. Examinez-les dans diskmap si vous voulez en vider un.
app.reclaim.shared.one = {path} · {size} · utilisé par {n} worktree d’ici
app.reclaim.shared.other = {path} · {size} · utilisé par {n} worktrees d’ici
app.reclaim.idle.one = inchangé depuis {n} jour
app.reclaim.idle.other = inchangé depuis {n} jours
app.reclaim.delete_branches = Supprimer aussi leurs branches fusionnées (git branch -d)
app.reclaim.never = Ne sont jamais touchés : les worktrees avec du travail non validé ou non poussé, les verrouillés, celui ouvert ici, les branches protégées, les réglages et installations d’outils, les dossiers cloud et tout ce qui est hors du worktree. Tout est revérifié juste avant d’être déplacé.
