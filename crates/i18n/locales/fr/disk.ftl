app.reclaim.confirm_ok = Mettre à la corbeille
app.reclaim.running = Mise à la corbeille…
app.reclaim.close = Fermer
app.reclaim.none = Rien à libérer pour l’instant : aucun worktree fusionné ni cache de build à supprimer.
app.reclaim.none_yet = Mesure des worktrees en cours…
app.reclaim.freed = {size} mis à la corbeille. Videz la corbeille pour récupérer l’espace.
