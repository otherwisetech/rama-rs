# Liberar espacio: worktrees fusionados y carpetas de compilación, aviso en Hoy, diskmap
app.reclaim.title = Liberar espacio
app.reclaim.menu = Liberar espacio…
app.reclaim.menu_size = Liberar {size}…
app.reclaim.total = Se pueden liberar {size} con seguridad
